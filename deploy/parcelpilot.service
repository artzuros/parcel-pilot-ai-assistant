[Unit]
Description=ParcelPilot Ops Assistant API (DeepSeek + FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/parcel-pilot-ai-assistant/backend
EnvironmentFile=/etc/parcelpilot.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/ubuntu/parcel-pilot-ai-assistant/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
